# Copy this file to .env and enter YOUR OWN key. Never commit .env.
HKUST_API_KEY=

# Optional, for direct Google Gemini API (not the HKUST gateway):
# GEMINI_API_KEY=

# Optional, only if using DeepSeek API review:
# DEEPSEEK_API_KEY=

# One-command replication (run_auto_pipeline.sh). Leave a value blank to use the default.
MEMBER_ID=member_4
MODEL=qwen
SLURM_ACCOUNT=mscbdt2024
SLURM_PARTITION=normal

# OpenAI-compatible review endpoint: OpenAI, Gemini, xAI Grok, or HKUST GenAI.
# Examples:
#   https://api.openai.com/v1
#   https://generativelanguage.googleapis.com/v1beta/openai
#   https://api.x.ai/v1
#   https://hkust.azure-api.net/hkust-genai/v1
REVIEW_API_BASE_URL=
REVIEW_API_KEY=
REVIEW_MODEL=

# api calls the endpoint above. heuristic writes deterministic reviews with no network.
REVIEW_FALLBACK_MODE=api
